[{"id":"bt-0431","locale":"es","targetText":"¿Qué calibre de cable para 20 amperios? NEC/distancias | VoltDrop"},{"id":"bt-0432","locale":"es","targetText":"Qué calibre de cable para un circuito de 20 amperios: 12 AWG de cobre, por qué el 14 AWG está limitado a 15 amperios, y tabla de distancia a 120 V verificada."},{"id":"bt-0433","locale":"es","targetText":"¿Qué calibre de cable para 30 amperios? Secadora y RV | VoltDrop"},{"id":"bt-0434","locale":"es","targetText":"Qué calibre de cable para un interruptor de 30 amperios: 10 AWG de cobre, tablas de distancia verificadas de 240 V y 120 V, y ejemplos de secadora y RV."},{"id":"bt-0435","locale":"es","targetText":"¿Qué calibre de cable para 40 amperios? Estufa y EV | VoltDrop"},{"id":"bt-0436","locale":"es","targetText":"Qué calibre de cable para 40 amperios: 8 AWG de cobre, ampacidad 60°C contra 75°C, tabla de distancia verificada y ejemplos de estufa y cargador EV."},{"id":"bt-0437","locale":"es","targetText":"¿Qué calibre de cable para 60 amperios? Calibre 6 vs 4 | VoltDrop"},{"id":"bt-0438","locale":"es","targetText":"Qué calibre de cable para 60 amperios: cuándo sirve 6 AWG de cobre y cuándo 60°C exige 4 AWG, con tabla de distancia verificada y cálculo para cargador EV."},{"id":"bt-0439","locale":"es","targetText":"Calibre de cable para acometida de 100 A — NEC 310.12 | VoltDrop"},{"id":"bt-0440","locale":"es","targetText":"Calibre de cable para acometida de 100 A: aritmética del NEC 310.12, contraste 310.16, las cuatro condiciones y una tabla de distancia verificada a 240 V."},{"id":"bt-0441","locale":"es","targetText":"Calibre de cable para acometida de 200 A — 2/0 vs 3/0 | VoltDrop"},{"id":"bt-0442","locale":"es","targetText":"Concilia 2/0 y 3/0 de cobre más 4/0 de aluminio para una acometida de 200 A con la cuenta del NEC 310.12, las condiciones y una tabla de distancia verificada."},{"id":"bt-0443","locale":"es","targetText":"Diagrama: el 8 AWG de cobre está clasificado en 40 amperios a 60 grados C y 50 amperios a 75 grados C en condiciones ordinarias"},{"id":"bt-0444","locale":"es","targetText":"Diagrama: el 6 AWG de cobre alcanza 65 amperios a 75 grados C, mientras que la consulta a 60 grados C exige 4 AWG de cobre a 70 amperios"},{"id":"bt-0875","locale":"zh-Hans","targetText":"20 安培该用多大的线？NEC 断路器与距离表 | VoltDrop"},{"id":"bt-0876","locale":"zh-Hans","targetText":"20 安培电路该用多大的线：12 AWG 铜线的答案、为什么 14 AWG 最高只能配 15 安培，以及经核验的 120 V 距离表。"},{"id":"bt-0877","locale":"zh-Hans","targetText":"30 安培该用多大的线？烘干机、房车与断路器对照表 | VoltDrop"},{"id":"bt-0878","locale":"zh-Hans","targetText":"30 安培断路器该用多大的线：10 AWG 铜线的答案、经核验的 240 V 与 120 V 两套距离表，以及清楚的烘干机与房车实例。"},{"id":"bt-0879","locale":"zh-Hans","targetText":"40 安培该用多大的线？炉灶与电动车断路器指南 | VoltDrop"},{"id":"bt-0880","locale":"zh-Hans","targetText":"40 安培断路器该用多大的线：8 AWG 铜线的答案、60°C 与 75°C 载流量的差别、经核验的距离表，以及炉灶与电动车实例。"},{"id":"bt-0881","locale":"zh-Hans","targetText":"60 安培该用多大的线？6 号线规还是 4 号线规 | VoltDrop"},{"id":"bt-0882","locale":"zh-Hans","targetText":"60 安培断路器该用多大的线：什么时候 6 AWG 铜线够用、什么时候 60°C 方法要求 4 AWG，附经核验的距离表和电动车换算。"},{"id":"bt-0883","locale":"zh-Hans","targetText":"100 安培供电进线导线规格——NEC 310.12 讲解 | VoltDrop"},{"id":"bt-0884","locale":"zh-Hans","targetText":"100 安培住宅供电进线的导线规格：NEC 310.12 的计算、与普通 310.16 的对比、全部四个条件，以及经核验的 240 V 距离表。"},{"id":"bt-0885","locale":"zh-Hans","targetText":"200 安培供电进线导线规格——2/0 与 3/0 该怎么选 | VoltDrop"},{"id":"bt-0886","locale":"zh-Hans","targetText":"厘清 200 安培供电进线里 2/0、3/0 铜线和 4/0 铝线的区别：NEC 310.12 的计算、适用条件，以及经核验的距离表。"},{"id":"bt-0887","locale":"zh-Hans","targetText":"示意图：在常规条件下，8 AWG 铜线在 60°C 那一栏额定 40 安培，在 75°C 那一栏额定 50 安培"},{"id":"bt-0888","locale":"zh-Hans","targetText":"示意图：6 AWG 铜线在 75°C 那一栏能达到 65 安培，而 60°C 查表则要求改用 4 AWG 铜线（额定 70 安培）"},{"id":"bt-1327","locale":"fr-CA","targetText":"Quel calibre de conducteur CEC pour 20 A ? NMD90 | VoltDrop"},{"id":"bt-1328","locale":"fr-CA","targetText":"La réponse canadienne pour 20 A : cuivre 12 AWG NMD90, pourquoi le 14 AWG est plafonné à 15 A, et un tableau de distances vérifié en métrique à 120 V."},{"id":"bt-1329","locale":"fr-CA","targetText":"Calibre de conducteur pour 30 A, Canada ? Sécheuse, VR | VoltDrop"},{"id":"bt-1330","locale":"fr-CA","targetText":"La réponse canadienne pour 30 A : cuivre 10 AWG NMD90, tableaux de distances à 240 V et 120 V, avec des conseils pour sécheuse et VR."},{"id":"bt-1331","locale":"fr-CA","targetText":"Quel calibre de conducteur CEC pour 40 A ? Cuisinière | VoltDrop"},{"id":"bt-1332","locale":"fr-CA","targetText":"La réponse canadienne pour 40 A : cuivre 8 AWG NMD90 selon la méthode à 60°C, avec un tableau de distances vérifié et des exemples cuisinière et VÉ."},{"id":"bt-1333","locale":"fr-CA","targetText":"Calibre de conducteur pour 60 A au Canada ? Calibres 6 ou 4 | VoltDrop"},{"id":"bt-1334","locale":"fr-CA","targetText":"La réponse canadienne pour 60 A : cuivre 4 AWG à 60°C contre 6 AWG à 75°C, avec un tableau de distances vérifié et le calcul pour VÉ."},{"id":"bt-1335","locale":"fr-CA","targetText":"Branchement de 100 A au Canada ? Sans calibre fixe | VoltDrop"},{"id":"bt-1336","locale":"fr-CA","targetText":"Pourquoi la règle américaine des 83% pour le branchement ne s’applique pas au Canada, ce que change la Section 8, et où vérifier un conducteur."},{"id":"bt-1337","locale":"fr-CA","targetText":"Branchement de 200 A au Canada ? Sans calibre fixe | VoltDrop"},{"id":"bt-1338","locale":"fr-CA","targetText":"Pourquoi les calibres américains 2/0, 3/0 et 4/0 ne fixent pas un calibre canadien, avec une note sur la portée de la Section 8 et où vérifier."},{"id":"bt-1777","locale":"zh-Hans","targetText":"在加拿大 20 安培该用多大的线？CEC、NMD90 | VoltDrop"},{"id":"bt-1778","locale":"zh-Hans","targetText":"加拿大 20 安培的答案：12 AWG 铜芯 NMD90，为什么 14 AWG 被限制在 15 安培，以及经核验、公制优先的 120 V 距离表。"},{"id":"bt-1779","locale":"zh-Hans","targetText":"在加拿大 30 安培该用多大的线？烘干机与房车表格 | VoltDrop"},{"id":"bt-1780","locale":"zh-Hans","targetText":"加拿大 30 安培的答案：10 AWG 铜芯 NMD90，240 V 和 120 V 分开的距离表，以及烘干机和房车的实用指导。"},{"id":"bt-1781","locale":"zh-Hans","targetText":"在加拿大 40 安培该用多大的线？CEC 炉灶与电动车指南 | VoltDrop"},{"id":"bt-1782","locale":"zh-Hans","targetText":"加拿大 40 安培的答案：按保守的 60°C 方法用 8 AWG 铜芯 NMD90，附经核验的距离表，以及炉灶和电动车的实例。"},{"id":"bt-1783","locale":"zh-Hans","targetText":"在加拿大 60 安培该用多大的线？6 号线还是 4 号线 | VoltDrop"},{"id":"bt-1784","locale":"zh-Hans","targetText":"加拿大 60 安培的答案：60°C 方法下的 4 AWG 铜芯，对比 75°C 下的 6 AWG，附经核验的距离表和电动车的负载计算。"},{"id":"bt-1785","locale":"zh-Hans","targetText":"加拿大 100 安培供电进线的导线规格——诚实说明范围 | VoltDrop"},{"id":"bt-1786","locale":"zh-Hans","targetText":"为什么美国 83% 住宅供电进线的答案搬不到加拿大、Section 8 改变了什么，以及去哪里核对拟定的导体或馈线规格。"},{"id":"bt-1787","locale":"zh-Hans","targetText":"加拿大 200 安培供电进线的导线规格——诚实说明范围 | VoltDrop"},{"id":"bt-1788","locale":"zh-Hans","targetText":"为什么美国 2/0、3/0、4/0 的供电进线答案定不出加拿大的规格，附诚实的 Section 8 范围说明和经核验的核对途径。"}]